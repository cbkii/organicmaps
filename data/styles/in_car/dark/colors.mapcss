/* High-contrast in-car dark palette with bright road surfaces and blacker edges. */

/* BASE */
@background: #202124;

/* BOUNDARIES */
@border_country: #666C72;
@border_region: #4E5358;

/* ROADS */
@trunk0: #B5BCC2;
@trunk1: #B5BCC2;
@primary0: #A5ACB2;
@primary1: #A0A7AD;
@primary2: #A0A7AD;
@secondary0: #9DA4AA;
@residential: #90979D;
@unclassified: #888F95;
@pedestrian: #61676C;
@footway: #4A4F53;
@cycleway: #4E616D;
@construction: #555B60;
@track: #5C5650;
@path: #55504A;
@bridleway: #4C4741;

@bridge_background: #202124;
@bridge_casing: #050607;
@casing_road: #080A0C;
@casing_road_major: #050607;
@casing_road_local: #0D0F11;

@primary_tunnel: #737A80;
@trunk_tunnel: #7D848A;
@primary_tunnel_casing: #030405;
@trunk_tunnel_casing: #030405;
@secondary_tunnel: #686F75;
@secondary_tunnel_casing: #030405;
@tertiary_tunnel: #5E656B;
@tertiary_tunnel_casing: #030405;
@unclassified_tunnel: #565D63;
@unclassified_tunnel_casing: #030405;

/* TRANSPORT */
@railway_light: #444A4F;
@railway: #565C61;
@railway_tourism: #5A524A;
@railway_dash: #202124;
@railway_tunnel: #3C4044;
@tram: #555B60;

/* AERODROME */
@aerodrome0: #2C2E31;
@aerodrome1: #2C2E31;
@aerodrome2: #2C2E31;
@aerodrome3: #2C2E31;
@aerodrome4: #2C2E31;
@aerodrome5: #2C2E31;

/* NATURAL */
@glacier: #34373A;
@water: #163B40;
@water_bad: #173733;
@river: #4EA4AD;
@wetland: #19322E;
@forest: #1C3224;
@beach: #49432B;
@barerock: #383533;
@desert: #3B3424;

@green0: #223B2A;
@green1: #223B2A;
@green2: #203827;
@green3: #1F3526;
@green4: #1D3325;
@green5: #1C3224;
@green6: #536A3E;
@leisure: #292D29;

/* BUILDINGS */
@housenumber: #D0D4D8;
@building_label: #D0D4D8;
@building0: #2B2D30;
@building1: #303236;
@building_border0: #4E5358;

/* LANDUSE */
@industrial: #29272B;
@sport: #203127;
@parking: #2B2D2E;
@parking_l: #313335;
@military: #8F2B24;
@prison: #747A80;
@farmland: #2C2D24;
@farmyard: #302D27;

/* BARRIERS */
@fence: #5A6065;
@hedge: #35583A;
@cliff: #735E4E;

/* LABELS */
@label_dark: #F1F3F4;
@label_medium: #DADCE0;
@label_light: #C7CBD0;
@label_halo_medium: #050607;
@label_halo_light: #050607;

@city_label: #F1F3F4;
@country_label: #C7CBD0;
@state_label: #C7CBD0;
@district_label: #AEB4B9;
@poi_label: #DADCE0;
@subway_label: #C7CBD0;

@shield_text: #202124;
@shield_text_halo: #050607;
@shield: #E4E7EA;
@shield_outline: #050607;

@water_label: #78C7CF;
@park_label: #9BC49A;
@halo_park_label: #050607;

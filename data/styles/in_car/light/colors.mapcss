/* High-glare in-car palette: bright roads over darker neutral surroundings. */

/* BASE */
@background: #C6CCD1;

/* BOUNDARIES */
@border_country: #8A9197;
@border_region: #A6ADB3;

/* ROADS */
@trunk0: #FFFFFF;
@trunk1: #FFFFFF;
@primary0: #FFFFFF;
@primary1: #FAFBFC;
@primary2: #FAFBFC;
@secondary0: #FFFFFF;
@residential: #FFFFFF;
@unclassified: #F7F9FA;
@pedestrian: #E4E8EB;
@footway: #AAB1B7;
@cycleway: #8E9CA7;
@construction: #A7ADB3;
@track: #8F8982;
@path: #9B958F;
@bridleway: #87817B;

@bridge_background: #C6CCD1;
@bridge_casing: #41474C;
@casing_road: #555C62;
@casing_road_major: #41474C;
@casing_road_local: #697178;

@primary_tunnel: #E2E7EA;
@trunk_tunnel: #E5EAED;
@primary_tunnel_casing: #41474C;
@trunk_tunnel_casing: #41474C;
@secondary_tunnel: #DEE4E8;
@secondary_tunnel_casing: #555C62;
@tertiary_tunnel: #D8DEE2;
@tertiary_tunnel_casing: #555C62;
@unclassified_tunnel: #D4DADE;
@unclassified_tunnel_casing: #697178;

/* TRANSPORT */
@railway_light: #AEB5BB;
@railway: #8F979E;
@railway_tourism: #A5998E;
@railway_dash: #C6CCD1;
@railway_tunnel: #7E868D;
@tram: #969EA5;

/* AERODROME */
@aerodrome0: #D7DBDE;
@aerodrome1: #D7DBDE;
@aerodrome2: #D7DBDE;
@aerodrome3: #D7DBDE;
@aerodrome4: #D7DBDE;
@aerodrome5: #D7DBDE;

/* NATURAL */
@glacier: #FFFFFF;
@water: #A8DADC;
@water_bad: #B7D5D2;
@river: #72BFC4;
@wetland: #D7E7E2;
@forest: #C8DFC3;
@beach: #F8E7A5;
@barerock: #D5D0C8;
@desert: #EFE4BC;

@green0: #D8EAD3;
@green1: #D4E9CF;
@green2: #D0E6CB;
@green3: #CCE3C7;
@green4: #C8DFC3;
@green5: #C8DFC3;
@green6: #6F8950;
@leisure: #DCE3DA;

/* BUILDINGS */
@housenumber: #4B5156;
@building_label: #4B5156;
@building0: #D9DDE0;
@building1: #D1D6DA;
@building_border0: #A6ADB3;

/* LANDUSE */
@industrial: #D8D5D9;
@sport: #CDE0C9;
@parking: #D6DADD;
@parking_l: #DEE1E4;
@military: #D93025;
@prison: #697178;
@farmland: #E1E0C8;
@farmyard: #DCD5C6;

/* BARRIERS */
@fence: #858C92;
@hedge: #5F8D58;
@cliff: #8A715E;

/* LABELS */
@label_dark: #202124;
@label_medium: #34383B;
@label_light: #4B5156;
@label_halo_medium: #F1F3F4;
@label_halo_light: #FFFFFF;

@city_label: #202124;
@country_label: #4B5156;
@state_label: #4B5156;
@district_label: #4B5156;
@poi_label: #34383B;
@subway_label: #4B5156;

@shield_text: #202124;
@shield_text_halo: #FFFFFF;
@shield: #FFFFFF;
@shield_outline: #41474C;

@water_label: #00565B;
@park_label: #2E6033;
@halo_park_label: #FFFFFF;

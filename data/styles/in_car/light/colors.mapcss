/* High-glare InCar light palette.
 *
 * The TS18 panel needs stronger separation than a desktop-oriented light map:
 * cool/darker surroundings, warm high-luminance roads, dark casings and a
 * blue active route provide independent luminance, hue and edge cues.
 */

/* BASE */
@background: #78838C;

/* BOUNDARIES */
@border_country: #5E676E;
@border_region: #6A747C;

/* ROADS */
@trunk0: #FFE0A0;
@trunk1: #FFE0A0;
@primary0: #FFE7B0;
@primary1: #FFE7B0;
@primary2: #FFE7B0;
@secondary0: #FFF0D0;
@residential: #FFF7E8;
@unclassified: #FFF3DC;
@pedestrian: #E1D9CF;
@footway: #9FA8AE;
@cycleway: #7E93A1;
@construction: #92999F;
@track: #82786E;
@path: #8C8177;
@bridleway: #766D64;

@bridge_background: #78838C;
@bridge_casing: #20262B;
@casing_road: #2A3137;
@casing_road_major: #080C10;
@casing_road_local: #2B3237;

@primary_tunnel: #DCCFB9;
@trunk_tunnel: #DEC89F;
@primary_tunnel_casing: #20262B;
@trunk_tunnel_casing: #20262B;
@secondary_tunnel: #D8D0C4;
@secondary_tunnel_casing: #2A3137;
@tertiary_tunnel: #D1CBC3;
@tertiary_tunnel_casing: #2A3137;
@unclassified_tunnel: #CBC5BD;
@unclassified_tunnel_casing: #343C42;

/* TRANSPORT */
@railway_light: #9CA5AB;
@railway: #7F8990;
@railway_tourism: #948779;
@railway_dash: #78838C;
@railway_tunnel: #68727A;
@tram: #858F96;

/* AERODROME */
@aerodrome0: #8D99A2;
@aerodrome1: #8D99A2;
@aerodrome2: #8D99A2;
@aerodrome3: #8D99A2;
@aerodrome4: #8D99A2;
@aerodrome5: #8D99A2;

/* NATURAL */
@glacier: #F7FBFC;
@water: #74CAD2;
@water_bad: #91BFC0;
@river: #40AEB9;
@wetland: #A8CDC5;
@forest: #B4D5A5;
@beach: #F3D982;
@barerock: #B7B0A5;
@desert: #D9C998;

@green0: #C9DDBA;
@green1: #C4DBB2;
@green2: #BFD8AD;
@green3: #BAD5A8;
@green4: #B4D5A5;
@green5: #B4D5A5;
@green6: #5D7A43;
@leisure: #9DAA98;

/* BUILDINGS */
@housenumber: #252A2E;
@building_label: #252A2E;
@building0: #969FA6;
@building1: #8D979F;
@building_border0: #68737C;

/* LANDUSE */
@industrial: #68747D;
@sport: #B7D2A8;
@parking: #89949C;
@parking_l: #929CA3;
@military: #D93025;
@prison: #59636B;
@farmland: #BBC39A;
@farmyard: #B8AA8F;

/* BARRIERS */
@fence: #59636B;
@hedge: #4E824A;
@cliff: #7C624D;

/* LABELS */
@label_dark: #181B1D;
@label_medium: #252A2E;
@label_light: #161A1D;
@label_halo_medium: #F4F1EA;
@label_halo_light: #FFFFFF;
@in_car_place_label: #493200;

@city_label: #181B1D;
@country_label: #30363B;
@state_label: #30363B;
@district_label: #30363B;
@poi_label: #252A2E;
@subway_label: #30363B;

@shield_text: #181B1D;
@shield_text_halo: #FFFFFF;
@shield: #FFF8E8;
@shield_outline: #20262B;

@water_label: #00464A;
@park_label: #24522A;
@halo_park_label: #FFFFFF;

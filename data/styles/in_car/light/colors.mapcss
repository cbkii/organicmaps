/* Google-like in-car palette: neutral roads, teal water, restrained landuse. */

/* BASE */
@background: #F1F3F4;

/* BOUNDARIES */
@border_country: #9AA0A6;
@border_region: #BDC1C6;

/* ROADS */
@trunk0: #DADCE0;
@trunk1: #DADCE0;
@primary0: #E3E6E8;
@primary1: #E8EAED;
@primary2: #E8EAED;
@secondary0: #F1F3F4;
@residential: #FFFFFF;
@unclassified: #F8F9FA;
@pedestrian: #E8EAED;
@footway: #C7CBCF;
@cycleway: #AAB4BE;
@construction: #BDC1C6;
@track: #A7A29B;
@path: #B0ACA6;
@bridleway: #A09B95;

@bridge_background: #F1F3F4;
@bridge_casing: #5F6368;
@casing_road: #80868B;
@casing_road_major: #5F6368;
@casing_road_local: #80868B;

@primary_tunnel: #DADCE0;
@trunk_tunnel: #DADCE0;
@primary_tunnel_casing: #5F6368;
@trunk_tunnel_casing: #5F6368;
@secondary_tunnel: #E8EAED;
@secondary_tunnel_casing: #80868B;
@tertiary_tunnel: #F1F3F4;
@tertiary_tunnel_casing: #80868B;
@unclassified_tunnel: #F1F3F4;
@unclassified_tunnel_casing: #80868B;

/* TRANSPORT */
@railway_light: #C8CDD1;
@railway: #AEB4B9;
@railway_tourism: #B8AEA5;
@railway_dash: #F1F3F4;
@railway_tunnel: #9AA0A6;
@tram: #B0B5BA;

/* AERODROME */
@aerodrome0: #E8EAED;
@aerodrome1: #E8EAED;
@aerodrome2: #E8EAED;
@aerodrome3: #E8EAED;
@aerodrome4: #E8EAED;
@aerodrome5: #E8EAED;

/* NATURAL */
@glacier: #FFFFFF;
@water: #A8DADC;
@water_bad: #B7D5D2;
@river: #72BFC4;
@wetland: #D7E7E2;
@forest: #C8DFC3;
@beach: #F8E7A5;
@barerock: #E1DDD5;
@desert: #EFE4BC;

@green0: #D8EAD3;
@green1: #D4E9CF;
@green2: #D0E6CB;
@green3: #CCE3C7;
@green4: #C8DFC3;
@green5: #C8DFC3;
@green6: #7F995D;
@leisure: #EEF1EA;

/* BUILDINGS */
@housenumber: #5F6368;
@building_label: #5F6368;
@building0: #E8EAED;
@building1: #DFE2E5;
@building_border0: #BDC1C6;

/* LANDUSE */
@industrial: #E9E7EA;
@sport: #D9E8D5;
@parking: #E7E9EA;
@parking_l: #F0F1F2;
@military: #D93025;
@prison: #80868B;
@farmland: #ECEBD7;
@farmyard: #E7E1D3;

/* BARRIERS */
@fence: #9AA0A6;
@hedge: #6F9B66;
@cliff: #9A806B;

/* LABELS */
@label_dark: #202124;
@label_medium: #3C4043;
@label_light: #5F6368;
@label_halo_medium: #F1F3F4;
@label_halo_light: #FFFFFF;

@city_label: #202124;
@country_label: #5F6368;
@state_label: #5F6368;

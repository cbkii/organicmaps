/* High-glare in-car daylight palette.
 *
 * Warm road fills sit against a cooler, darker slate environment so road hierarchy survives
 * reflected daylight without depending on hue alone. Dark casings provide an independent edge cue.
 */

/* BASE */
@background: #78838C;

/* BOUNDARIES */
@border_country: #4F5961;
@border_region: #66717A;

/* ROADS */
@trunk0: #FFE0A0;
@trunk1: #FFE0A0;
@primary0: #FFE7B0;
@primary1: #FFE7B0;
@primary2: #FFE7B0;
@secondary0: #FFF0D0;
@residential: #FFF7E8;
@unclassified: #FFF3DC;
@pedestrian: #E7DED0;
@footway: #9AA4AB;
@cycleway: #7492A6;
@construction: #9C8F7E;
@track: #817568;
@path: #8C8073;
@bridleway: #746A60;

@bridge_background: #78838C;
@bridge_casing: #20262B;
@casing_road: #2A3137;
@casing_road_major: #20262B;
@casing_road_local: #343C42;

@primary_tunnel: #D9C9AC;
@trunk_tunnel: #DCC7A0;
@primary_tunnel_casing: #20262B;
@trunk_tunnel_casing: #20262B;
@secondary_tunnel: #DDD2C0;
@secondary_tunnel_casing: #2A3137;
@tertiary_tunnel: #D5CEC4;
@tertiary_tunnel_casing: #2A3137;
@unclassified_tunnel: #CEC8BF;
@unclassified_tunnel_casing: #343C42;

/* TRANSPORT */
@railway_light: #929CA4;
@railway: #69747D;
@railway_tourism: #8E7968;
@railway_dash: #78838C;
@railway_tunnel: #5B656D;
@tram: #7A858D;

/* AERODROME */
@aerodrome0: #919BA3;
@aerodrome1: #919BA3;
@aerodrome2: #919BA3;
@aerodrome3: #919BA3;
@aerodrome4: #919BA3;
@aerodrome5: #919BA3;

/* NATURAL */
@glacier: #F7FBFC;
@water: #74CAD2;
@water_bad: #8BBDBA;
@river: #3FAEB9;
@wetland: #A9C6BE;
@forest: #A9CF9B;
@beach: #F2D98C;
@barerock: #ACA397;
@desert: #D9C995;

@green0: #BED8B5;
@green1: #B7D5AD;
@green2: #B0D2A5;
@green3: #ACD09F;
@green4: #A9CF9B;
@green5: #A9CF9B;
@green6: #536F3D;
@leisure: #8FA094;

/* BUILDINGS */
@housenumber: #202124;
@building_label: #202124;
@building0: #A1A8AD;
@building1: #949CA2;
@building_border0: #69737B;

/* LANDUSE */
@industrial: #646F78;
@sport: #A8CE9C;
@parking: #939CA3;
@parking_l: #A9B0B5;
@military: #D93025;
@prison: #4F5961;
@farmland: #B7BE92;
@farmyard: #B6A88F;

/* BARRIERS */
@fence: #4F5961;
@hedge: #487A45;
@cliff: #765A45;

/* LABELS */
@label_dark: #202124;
@label_medium: #2B3034;
@label_light: #343B40;
@label_halo_medium: #F6F3E9;
@label_halo_light: #FFFFFF;
@in_car_place_label: #6B5000;

@city_label: #202124;
@country_label: #343B40;
@state_label: #343B40;
@district_label: #343B40;
@poi_label: #2B3034;
@subway_label: #343B40;

@shield_text: #202124;
@shield_text_halo: #FFFFFF;
@shield: #FFF7E8;
@shield_outline: #20262B;

@water_label: #004E55;
@park_label: #285A2D;
@halo_park_label: #FFFFFF;

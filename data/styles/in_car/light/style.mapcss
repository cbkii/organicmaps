@import("colors.mapcss");
@import("../../vehicle/include/defaults.mapcss");
@import("../../vehicle/include/Basemap.mapcss");
@import("../../vehicle/include/Basemap_label.mapcss");
@import("../../vehicle/include/Roads.mapcss");
@import("../../vehicle/include/Roads_label.mapcss");
@import("../../vehicle/include/Icons.mapcss");
@import("../../vehicle/include/Subways.mapcss");
@import("../include/InCarOverrides.mapcss");

/* High-glare light-only driving-road opacity override. */
/*
 * Vehicle road rules deliberately fade the core driving hierarchy at lower
 * zooms (including 0.3, 0.7 and 0.8 fills). On the darker InCar light base
 * those blends erase the luminance hierarchy that this palette guarantees.
 *
 * Keep only the ordinary, non-tunnel driving roads opaque here. z14+ is also
 * made opaque by InCarOverrides; tunnels retain their existing treatment.
 * This file is imported only by the InCar light/day style, so night is
 * unchanged.
 */
line|z6-13[highway=motorway][!tunnel],
line|z6-13[highway=trunk][!tunnel],
line|z10-13[highway=motorway_link][!tunnel],
line|z10-13[highway=trunk_link][!tunnel],
line|z8-13[highway=primary][!tunnel],
line|z11-13[highway=primary_link][!tunnel],
line|z10-13[highway=secondary][!tunnel],
line|z13[highway=secondary_link][!tunnel],
line|z11-13[highway=tertiary][!tunnel],
line|z12-13[highway=residential][!tunnel],
line|z11-13[highway=unclassified][!tunnel],
line|z12-13[highway=road][!tunnel],
line|z12-13[highway=living_street][!tunnel]
{opacity: 1;}

/*
 * Typical driving zooms get a modest ~15% geometry lift in the light style.
 * This is deliberately not a global renderer scale: path/footway detail and
 * the night style retain their existing geometry, while the ordinary road
 * hierarchy receives more physical stroke area to survive panel wash-out.
 */
line|z12[highway=motorway][!tunnel], line|z12[highway=trunk][!tunnel] {width: 4.25;}
line|z13[highway=motorway][!tunnel], line|z13[highway=trunk][!tunnel] {width: 5.3;}
line|z14[highway=motorway][!tunnel], line|z14[highway=trunk][!tunnel] {width: 5.65; casing-width: 0.9;}
line|z15[highway=motorway][!tunnel], line|z15[highway=trunk][!tunnel] {width: 6.9; casing-width: 1.0;}
line|z16[highway=motorway][!tunnel], line|z16[highway=trunk][!tunnel] {width: 10.35; casing-width: 1.3;}
line|z17[highway=motorway][!tunnel], line|z17[highway=trunk][!tunnel] {width: 17.25; casing-width: 1.3;}
line|z18[highway=motorway][!tunnel], line|z18[highway=trunk][!tunnel] {width: 28.75; casing-width: 1.55;}

line|z12[highway=motorway_link][!tunnel], line|z12[highway=trunk_link][!tunnel] {width: 2.9;}
line|z13[highway=motorway_link][!tunnel], line|z13[highway=trunk_link][!tunnel] {width: 3.25;}
line|z14[highway=motorway_link][!tunnel], line|z14[highway=trunk_link][!tunnel] {width: 3.9; casing-width: 0.55;}
line|z15[highway=motorway_link][!tunnel], line|z15[highway=trunk_link][!tunnel] {width: 5.75; casing-width: 0.7;}
line|z16[highway=motorway_link][!tunnel], line|z16[highway=trunk_link][!tunnel] {width: 8.3; casing-width: 0.95;}
line|z17[highway=motorway_link][!tunnel], line|z17[highway=trunk_link][!tunnel] {width: 13.8; casing-width: 1.15;}
line|z18[highway=motorway_link][!tunnel], line|z18[highway=trunk_link][!tunnel] {width: 20.7; casing-width: 1.35;}

line|z12[highway=primary][!tunnel], line|z12[highway=primary_link][!tunnel] {width: 2.75;}
line|z13[highway=primary][!tunnel], line|z13[highway=primary_link][!tunnel] {width: 3.45;}
line|z14[highway=primary][!tunnel], line|z14[highway=primary_link][!tunnel] {width: 4.05; casing-width: 0.45;}
line|z15[highway=primary][!tunnel], line|z15[highway=primary_link][!tunnel] {width: 4.85; casing-width: 0.65;}
line|z16[highway=primary][!tunnel], line|z16[highway=primary_link][!tunnel] {width: 7.5; casing-width: 0.95;}
line|z17[highway=primary][!tunnel], line|z17[highway=primary_link][!tunnel] {width: 15; casing-width: 1.05;}
line|z18[highway=primary][!tunnel], line|z18[highway=primary_link][!tunnel] {width: 25.3; casing-width: 1.3;}

line|z12[highway=secondary][!tunnel] {width: 2.9;}
line|z13[highway=secondary][!tunnel], line|z13[highway=secondary_link][!tunnel] {width: 3.35;}
line|z14[highway=secondary][!tunnel], line|z14[highway=secondary_link][!tunnel] {width: 3.7; casing-width: 0.45;}
line|z15[highway=secondary][!tunnel], line|z15[highway=secondary_link][!tunnel] {width: 4.85; casing-width: 0.65;}
line|z16[highway=secondary][!tunnel], line|z16[highway=secondary_link][!tunnel] {width: 6.9; casing-width: 0.95;}
line|z17[highway=secondary][!tunnel], line|z17[highway=secondary_link][!tunnel] {width: 11; casing-width: 1.05;}
line|z18[highway=secondary][!tunnel], line|z18[highway=secondary_link][!tunnel] {width: 17.25; casing-width: 1.3;}

line|z12[highway=tertiary][!tunnel] {width: 1.4;}
line|z13[highway=tertiary][!tunnel] {width: 2.15;}
line|z14[highway=tertiary][!tunnel], line|z14[highway=tertiary_link][!tunnel] {width: 3.7; casing-width: 0.35;}
line|z15[highway=tertiary][!tunnel], line|z15[highway=tertiary_link][!tunnel] {width: 4.4; casing-width: 0.55;}
line|z16[highway=tertiary][!tunnel], line|z16[highway=tertiary_link][!tunnel] {width: 6.2; casing-width: 0.65;}
line|z17[highway=tertiary][!tunnel], line|z17[highway=tertiary_link][!tunnel] {width: 9.7; casing-width: 0.9;}
line|z18[highway=tertiary][!tunnel], line|z18[highway=tertiary_link][!tunnel] {width: 16.1; casing-width: 1.05;}

line|z12[highway=residential][!tunnel], line|z12[highway=unclassified][!tunnel], line|z12[highway=road][!tunnel], line|z12[highway=living_street][!tunnel] {width: 0.95;}
line|z13[highway=residential][!tunnel], line|z13[highway=unclassified][!tunnel], line|z13[highway=road][!tunnel], line|z13[highway=living_street][!tunnel] {width: 1.85;}
line|z14[highway=residential][!tunnel], line|z14[highway=unclassified][!tunnel], line|z14[highway=road][!tunnel], line|z14[highway=living_street][!tunnel] {width: 2.55; casing-width: 0.35;}
line|z15[highway=residential][!tunnel], line|z15[highway=unclassified][!tunnel], line|z15[highway=road][!tunnel], line|z15[highway=living_street][!tunnel] {width: 4.15; casing-width: 0.5;}
line|z16[highway=residential][!tunnel], line|z16[highway=unclassified][!tunnel], line|z16[highway=road][!tunnel], line|z16[highway=living_street][!tunnel] {width: 5.9; casing-width: 0.6;}
line|z17[highway=residential][!tunnel], line|z17[highway=unclassified][!tunnel], line|z17[highway=road][!tunnel], line|z17[highway=living_street][!tunnel] {width: 9.2; casing-width: 0.85;}
line|z18[highway=residential][!tunnel], line|z18[highway=unclassified][!tunnel], line|z18[highway=road][!tunnel], line|z18[highway=living_street][!tunnel] {width: 13.8; casing-width: 0.95;}

line|z15[highway=service][!tunnel] {width: 1.85; casing-width: 0.3;}
line|z16[highway=service][!tunnel] {width: 3.45; casing-width: 0.4;}
line|z17[highway=service][!tunnel] {width: 6.45; casing-width: 0.55;}
line|z18[highway=service][!tunnel] {width: 7.35; casing-width: 0.65;}


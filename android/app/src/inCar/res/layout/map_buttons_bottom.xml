<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/map_buttons_bottom"
  android:layout_width="match_parent" android:layout_height="wrap_content">
  <!-- Physical-side two-column dock. Keep all controller IDs, hide redundant actions. -->
  <LinearLayout android:id="@+id/in_car_browsing_controls"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_alignParentLeft="true" android:orientation="horizontal"
    android:clipChildren="false" android:clipToPadding="false"
    android:paddingLeft="@dimen/in_car_map_dock_edge"
    android:paddingRight="@dimen/in_car_map_dock_edge"
    android:paddingBottom="@dimen/in_car_map_dock_edge">
    <include layout="@layout/map_buttons_help"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:visibility="gone" />
    <include layout="@layout/map_buttons_bookmarks_square"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:visibility="gone" />
    <include layout="@layout/map_buttons_search_square"
      android:layout_width="@dimen/in_car_map_rail_cell_size"
      android:layout_height="@dimen/in_car_map_rail_cell_size"
      android:layout_marginRight="@dimen/in_car_map_dock_column_gap" />
    <include layout="@layout/map_buttons_menu"
      android:layout_width="@dimen/in_car_map_rail_cell_size"
      android:layout_height="@dimen/in_car_map_rail_cell_size" />
  </LinearLayout>
</RelativeLayout>

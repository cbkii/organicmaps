<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/in_car_driving_overlay"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipChildren="false"
  android:clipToPadding="false"
  android:clickable="false"
  android:focusable="false"
  android:visibility="gone">

  <!-- Physical top-right, matching the navigation ribbon's 60/72dp speed pair. -->
  <LinearLayout
    android:id="@+id/in_car_driving_speed_cluster"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|right"
    android:gravity="center_vertical"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    tools:ignore="RtlHardcoded">
    <app.organicmaps.sdk.widgets.speedlimit.SpeedLimitView
      android:id="@+id/in_car_road_speed_limit"
      style="@style/MwmWidget.SpeedLimit"
      android:layout_width="60dp"
      android:layout_height="60dp"
      android:layout_marginRight="4dp"
      android:clickable="false"
      android:focusable="false"
      android:visibility="gone"
      tools:ignore="RtlHardcoded" />
    <app.organicmaps.incar.InCarNavigationSpeedView
      android:id="@+id/in_car_speed"
      android:layout_width="72dp"
      android:layout_height="72dp"
      android:background="@drawable/in_car_speed_circle_background"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="--"
      android:textColor="?iconTint"
      android:textSize="28sp"
      android:textStyle="bold" />
  </LinearLayout>
</FrameLayout>

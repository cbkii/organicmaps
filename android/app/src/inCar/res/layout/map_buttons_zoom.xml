<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/in_car_camera_controls_rail"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <!-- The standard My Position control below this include is the single map-facing
       recentre/follow authority. Driving View remains an InCar setting/runtime policy rather
       than a second, visually competing camera button. -->
  <LinearLayout
    android:id="@+id/zoom_buttons_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/nav_zoom_in"
      style="@style/MwmWidget.MapButton.Zoom"
      android:layout_marginBottom="@dimen/in_car_map_zoom_gap"
      android:contentDescription="@string/zoom_in"
      android:foreground="@drawable/in_car_map_control_outline_round"
      app:backgroundTint="@color/in_car_map_button_background"
      app:fabCustomSize="@dimen/in_car_map_primary_button_size"
      app:maxImageSize="@dimen/in_car_map_zoom_icon_size"
      app:srcCompat="@drawable/ic_plus" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/nav_zoom_out"
      style="@style/MwmWidget.MapButton.Zoom"
      android:contentDescription="@string/zoom_out"
      android:foreground="@drawable/in_car_map_control_outline_round"
      app:backgroundTint="@color/in_car_map_button_background"
      app:fabCustomSize="@dimen/in_car_map_primary_button_size"
      app:maxImageSize="@dimen/in_car_map_zoom_icon_size"
      app:srcCompat="@drawable/ic_minus" />
  </LinearLayout>
  <!-- Track Recording remains a separate action below the camera-control rail. -->
  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/track_recording_status"
    style="@style/MwmWidget.MapButton.Zoom"
    android:layout_marginTop="@dimen/in_car_track_record_gap"
    android:contentDescription="@string/track_recording_title"
    android:foreground="@drawable/in_car_map_control_outline_round"
    app:backgroundTint="@color/in_car_map_button_background"
    app:fabCustomSize="@dimen/in_car_compact_map_button_size"
    app:maxImageSize="@dimen/in_car_map_zoom_icon_size"
    app:srcCompat="@drawable/ic_track_recording_status"
    android:visibility="gone" />
</LinearLayout>

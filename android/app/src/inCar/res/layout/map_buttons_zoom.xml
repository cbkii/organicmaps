<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/in_car_camera_controls_rail"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <!-- Compatibility-only owner for the established lifecycle/touch-target contract. The Driving
       View policy forces the legacy show-button key false, so this view remains GONE and is not a
       second user-facing camera authority. -->
  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@id/in_car_driving_view_button"
    style="@style/MwmWidget.MapButton.Zoom"
    android:contentDescription="@string/in_car_driving_view_button"
    android:visibility="gone"
    app:backgroundTint="@color/in_car_map_button_background"
    app:borderWidth="0dp"
    app:fabCustomSize="@dimen/in_car_map_primary_button_size"
    app:maxImageSize="@dimen/in_car_map_zoom_icon_size"
    app:srcCompat="@drawable/ic_in_car_driving_view"
    app:tint="@color/icon_tint" />

  <!-- One shared surface: zoom, native Follow Mode and independent camera/recenter. -->
  <LinearLayout
    android:id="@+id/zoom_buttons_container"
    android:background="@drawable/in_car_camera_rail"
    android:clipToOutline="true"
    android:layout_width="@dimen/in_car_map_primary_button_size"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatImageButton
      android:id="@+id/nav_zoom_in"
      android:layout_width="@dimen/in_car_map_primary_button_size"
      android:layout_height="@dimen/in_car_map_primary_button_size"
      android:background="@drawable/in_car_map_rail_cell_feedback"
      android:clickable="true" android:focusable="true"
      android:scaleType="centerInside"
      android:padding="@dimen/in_car_map_rail_icon_padding"
      android:contentDescription="@string/zoom_in"
      app:srcCompat="@drawable/ic_plus" />

    <View
      android:layout_width="match_parent"
      android:layout_height="@dimen/in_car_camera_rail_divider_width"
      android:layout_marginStart="@dimen/in_car_camera_rail_divider_inset"
      android:layout_marginEnd="@dimen/in_car_camera_rail_divider_inset"
      android:alpha="1.0"
      android:background="@color/in_car_divider" />

    <androidx.appcompat.widget.AppCompatImageButton
      android:id="@+id/nav_zoom_out"
      android:layout_width="@dimen/in_car_map_primary_button_size"
      android:layout_height="@dimen/in_car_map_primary_button_size"
      android:background="@drawable/in_car_map_rail_cell_feedback"
      android:clickable="true" android:focusable="true"
      android:scaleType="centerInside"
      android:padding="@dimen/in_car_map_rail_icon_padding"
      android:contentDescription="@string/zoom_out"
      app:srcCompat="@drawable/ic_minus" />

    <View
      android:layout_width="match_parent"
      android:layout_height="@dimen/in_car_camera_rail_divider_width"
      android:layout_marginStart="@dimen/in_car_camera_rail_divider_inset"
      android:layout_marginEnd="@dimen/in_car_camera_rail_divider_inset"
      android:alpha="1.0"
      android:background="@color/in_car_divider" />

    <include
      layout="@layout/map_buttons_myposition"
      android:layout_width="@dimen/in_car_map_primary_button_size"
      android:layout_height="@dimen/in_car_map_primary_button_size" />
    <View
      android:layout_width="match_parent"
      android:layout_height="@dimen/in_car_camera_rail_divider_width"
      android:layout_marginStart="@dimen/in_car_camera_rail_divider_inset"
      android:layout_marginEnd="@dimen/in_car_camera_rail_divider_inset"
      android:background="@color/in_car_divider" />
    <androidx.appcompat.widget.AppCompatImageButton
      android:id="@+id/in_car_camera_view_recenter"
      android:layout_width="@dimen/in_car_map_primary_button_size"
      android:layout_height="@dimen/in_car_map_primary_button_size"
      android:background="@drawable/in_car_map_rail_cell_feedback"
      android:clickable="true" android:focusable="true"
      android:scaleType="centerInside"
      android:padding="@dimen/in_car_map_rail_icon_padding"
      android:contentDescription="@string/in_car_camera_view_recenter"
      app:srcCompat="@drawable/ic_not_follow" />
  </LinearLayout>

</LinearLayout>

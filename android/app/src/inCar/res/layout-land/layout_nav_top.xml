<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/nav_top_frame"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:showIn="@layout/layout_nav">

  <!--
    InCar landscape uses one driver-information ribbon instead of independent floating cards.
    The existing controller IDs stay intact so routing, lanes, limits and speed keep one authority.
    Physical-edge safe-drawing insets are added to this whole ribbon by NavigationController.
  -->
  <LinearLayout
    android:id="@+id/nav_next_turn_container"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/in_car_nav_ribbon_min_height"
    android:background="?cardBackground"
    android:clickable="true"
    android:elevation="@dimen/nav_elevation"
    android:gravity="center_vertical"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/margin_half"
    android:paddingTop="@dimen/margin_half"
    android:paddingRight="@dimen/margin_half"
    android:paddingBottom="@dimen/margin_half"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    tools:ignore="RtlHardcoded">

    <!-- Immediate manoeuvre: large turn glyph plus glanceable distance. -->
    <LinearLayout
      android:id="@+id/nav_next_turn_frame"
      android:layout_width="@dimen/in_car_nav_manoeuvre_width"
      android:layout_height="@dimen/in_car_touch_target_preferred"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/turn"
        android:layout_width="@dimen/nav_next_turn_sign"
        android:layout_height="@dimen/nav_next_turn_sign"
        android:layout_gravity="center_vertical"
        android:theme="?navigationTheme"
        app:tint="?iconTint"
        tools:src="@drawable/ic_roundabout_exit_12" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
          android:id="@+id/distance"
          style="@style/MwmWidget.TextView.NavNextTurn"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textSize="@dimen/in_car_nav_distance_text_size"
          android:textStyle="bold"
          tools:text="320 m" />

        <!-- Next-next guidance stays subordinate to the immediate manoeuvre. -->
        <FrameLayout
          android:id="@+id/nav_next_next_turn_frame"
          android:layout_width="@dimen/nav_next_next_turn_frame"
          android:layout_height="@dimen/nav_next_next_turn_frame"
          android:layout_gravity="center_horizontal"
          android:visibility="gone"
          tools:visibility="visible">

          <ImageView
            android:id="@id/turn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="@dimen/margin_eighth"
            app:tint="?iconTint"
            tools:src="@drawable/ic_then_left_sharp" />
        </FrameLayout>
      </LinearLayout>
    </LinearLayout>

    <!-- Flexible centre: the road/instruction is primary; lane guidance appears only when present. -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_base"
      android:layout_marginEnd="@dimen/margin_base"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical">

      <FrameLayout
        android:id="@+id/street_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/in_car_nav_instruction_min_height">

        <TextView
          android:id="@+id/street"
          style="@style/MwmWidget.TextView.NavStreet"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center_vertical"
          android:ellipsize="end"
          android:gravity="start|center_vertical"
          android:includeFontPadding="false"
          android:layoutDirection="locale"
          android:maxLines="2"
          android:minHeight="@dimen/in_car_nav_instruction_min_height"
          android:textDirection="locale"
          android:textSize="@dimen/in_car_nav_instruction_text_size"
          android:textStyle="bold"
          tools:text="Northbourne Avenue towards City / Federal Highway" />
      </FrameLayout>

      <app.organicmaps.sdk.widgets.lanes.LanesView
        android:id="@+id/lanes"
        android:layout_width="match_parent"
        android:layout_height="@dimen/in_car_nav_lanes_height"
        android:padding="@dimen/margin_quarter"
        android:visibility="gone"
        app:lanesActiveLaneTintColor="?navLaneArrowActiveColor"
        app:lanesBackgroundColor="?navLanesBackgroundColor"
        app:lanesCornerRadius="@dimen/margin_quarter"
        app:lanesEditModeLanesCount="8"
        app:lanesInactiveLaneTintColor="?navLaneArrowInactiveColor"
        tools:visibility="visible" />
    </LinearLayout>

    <!-- Current speed and posted limit form one physical-right glance cluster. -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="@dimen/in_car_touch_target_preferred"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <app.organicmaps.sdk.widgets.speedlimit.SpeedLimitView
        android:id="@+id/nav_speed_limit"
        style="@style/MwmWidget.SpeedLimit"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="@dimen/margin_half" />

      <include
        android:id="@+id/in_car_nav_speed"
        layout="@layout/in_car_nav_speed"
        android:layout_width="@dimen/in_car_touch_target_preferred"
        android:layout_height="@dimen/in_car_touch_target_preferred" />
    </LinearLayout>
  </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

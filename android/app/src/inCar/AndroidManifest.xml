<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

  <uses-permission
      android:name="androidx.car.app.NAVIGATION_TEMPLATES"
      tools:node="remove"/>
  <uses-permission
      android:name="androidx.car.app.ACCESS_SURFACE"
      tools:node="remove"/>

  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <queries><package android:name="com.cbkii.ts18launcher" /></queries>
  <application>
    <!-- Signed cold-consent v1: OrganicMapsPrefs/InCarCompactStartup, unset=true.
         The paired root broker may read this only while this UID has no process.
         It conveys preference only; all task/renderer evidence remains boot-local. -->
    <meta-data android:name="app.organicmaps.incar.COMPACT_CONSENT_PREFS_PROTOCOL" android:value="1" />
    <provider
        android:name="app.organicmaps.incar.InCarCompactStartupProvider"
        android:authorities="${applicationId}.compact.startup"
        android:exported="true"
        android:grantUriPermissions="false"
        tools:ignore="ExportedContentProvider" />
    <receiver android:name="app.organicmaps.incar.InCarCompactBootReceiver" android:exported="false">
      <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
    </receiver>
    <!-- InCar alone advertises standard Android PiP. Entry remains externally/system owned: no
         auto-enter callbacks or OEM windowing hooks are added to the shared map Activity. -->
    <activity
        android:name="app.organicmaps.MwmActivity"
        android:supportsPictureInPicture="true" />

    <service
        android:name="app.organicmaps.car.AndroidAutoService"
        tools:node="remove"/>

    <activity
        android:name="app.organicmaps.car.screens.permissions.RequestPermissionsActivity"
        tools:node="remove"/>
    <activity
        android:name="app.organicmaps.editor.EditorActivity"
        tools:node="remove"/>
    <activity
        android:name="app.organicmaps.editor.ProfileActivity"
        tools:node="remove"/>
    <activity
        android:name="app.organicmaps.editor.FeatureCategoryActivity"
        tools:node="remove"/>
    <activity
        android:name="app.organicmaps.editor.ReportActivity"
        tools:node="remove"/>
    <activity
        android:name="app.organicmaps.editor.OsmLoginActivity"
        tools:node="remove"/>

    <meta-data
        android:name="com.google.android.gms.car.application"
        tools:node="remove"/>
    <meta-data
        android:name="androidx.car.app.minCarApiLevel"
        tools:node="remove"/>
  </application>
</manifest>

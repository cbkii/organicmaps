<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Preferred direct-display target; compact profiles may use only the explicit 90% floor. -->
  <dimen name="in_car_map_button_size">@dimen/in_car_touch_target_preferred</dimen>
  <dimen name="in_car_map_button_icon_size">36dp</dimen>
  <dimen name="in_car_zoom_button_icon_size">38dp</dimen>
  <dimen name="in_car_button_min_touch_target">@dimen/in_car_touch_target_preferred</dimen>

  <!-- Compact visual profiles preserve map space without dropping below the 69dp automotive floor. -->
  <dimen name="in_car_compact_map_button_size">@dimen/in_car_touch_target_min</dimen>
  <dimen name="in_car_compact_map_button_icon_size">32dp</dimen>
  <dimen name="in_car_compact_zoom_button_icon_size">34dp</dimen>
  <dimen name="in_car_compact_button_min_touch_target">@dimen/in_car_touch_target_min</dimen>

  <!-- Normal values preserve non-InCar/mobile rendering when these generic resources are used there. -->
  <dimen name="routing_action_button_size">40dp</dimen>
  <dimen name="routing_action_button_icon_size">28dp</dimen>
  <dimen name="routing_close_button_size">24dp</dimen>

  <dimen name="in_car_routing_action_button_size">@dimen/in_car_touch_target_preferred</dimen>
  <dimen name="in_car_routing_action_button_icon_size">32dp</dimen>
  <dimen name="in_car_routing_toolbar_cell_height">@dimen/in_car_touch_target_preferred</dimen>
  <dimen name="in_car_routing_close_button_size">@dimen/in_car_touch_target_preferred</dimen>

  <dimen name="in_car_compact_routing_action_button_size">@dimen/in_car_touch_target_min</dimen>
  <dimen name="in_car_compact_routing_action_button_icon_size">30dp</dimen>
  <dimen name="in_car_compact_routing_toolbar_cell_height">@dimen/in_car_touch_target_min</dimen>


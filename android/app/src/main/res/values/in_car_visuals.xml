  <dimen name="in_car_place_page_close_button_size">@dimen/in_car_touch_target_preferred</dimen>
  <dimen name="in_car_compact_close_button_size">@dimen/in_car_touch_target_min</dimen>
  <dimen name="in_car_close_icon_size">30dp</dimen>
  <dimen name="in_car_compact_close_icon_size">28dp</dimen>


<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Shared direct-display sizing tokens. Keep map, Quick and place-page controls aligned. -->
  <dimen name="in_car_runtime_button_size">56dp</dimen>
  <dimen name="in_car_runtime_button_icon_size">34dp</dimen>
  <dimen name="in_car_runtime_button_gap">6dp</dimen>

  <!-- Quick controls use one neutral translucent surface plus restrained semantic state feedback. -->
  <integer name="in_car_quick_surface_alpha">199</integer>
  <integer name="in_car_quick_pressed_feedback_alpha">82</integer>
  <integer name="in_car_quick_focused_feedback_alpha">61</integer>

  <!-- A 28dp radius gives rendered Quick search markers a 56dp in-car tap target. -->
  <dimen name="in_car_quick_marker_touch_radius">28dp</dimen>

  <!-- Place-page route actions use horizontal icon/text composition to protect bottom clearance. -->
  <dimen name="in_car_place_page_route_width">104dp</dimen>
  <dimen name="in_car_place_page_save_width">62dp</dimen>
  <dimen name="in_car_place_page_other_width">72dp</dimen>
  <dimen name="in_car_place_page_route_icon_size">32dp</dimen>
  <dimen name="in_car_place_page_save_icon_size">24dp</dimen>
  <dimen name="in_car_place_page_other_icon_size">28dp</dimen>
  <dimen name="in_car_place_page_route_text_gap">4dp</dimen>

  <!-- Runtime rows stay easy to hit without allowing low-information rows to become oversized. -->
  <dimen name="in_car_runtime_row_min_height">64dp</dimen>
  <dimen name="in_car_runtime_row_max_height">80dp</dimen>

  <string name="in_car_go_from">GO\nFROM</string>
  <string name="in_car_go_to">GO\nTO</string>
</resources>

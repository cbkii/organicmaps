<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/in_car_driving_overlay"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipChildren="false"
  android:clipToPadding="false"
  android:clickable="false"
  android:focusable="false"
  android:visibility="gone">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/in_car_driving_speed_cluster"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:minHeight="60dp"
    android:layoutDirection="ltr">
    <app.organicmaps.sdk.widgets.speedlimit.SpeedLimitView
      android:id="@+id/in_car_road_speed_limit"
      style="@style/MwmWidget.SpeedLimit"
      android:layout_width="60dp"
      android:layout_height="60dp"
      android:layout_marginEnd="8dp"
      app:layout_constraintEnd_toStartOf="@id/in_car_speed"
      app:layout_constraintTop_toTopOf="@id/in_car_speed"
      app:layout_constraintBottom_toBottomOf="@id/in_car_speed"
      android:clickable="false"
      android:focusable="false"
      android:visibility="gone" />
    <TextView
      android:id="@+id/in_car_speed"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      android:minWidth="104dp"
      android:gravity="center"
      android:background="@drawable/in_car_speed_background"
      android:paddingStart="14dp"
      android:paddingTop="7dp"
      android:paddingEnd="14dp"
      android:paddingBottom="7dp"
      android:text="--"
      android:textDirection="locale"
      android:layoutDirection="locale"
      android:textColor="?iconTint"
      android:textSize="24sp"
      android:textStyle="bold" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
